#!/usr/bin/env bash
# -*- coding: utf-8 -*-
#

set -Eeuo pipefail
trap cleanup SIGINT SIGTERM ERR EXIT

VERSION="0.7.0"

COLOR_MODE=auto # auto | always | never
NOFORMAT='' RED='' GREEN='' ORANGE='' BLUE='' PURPLE='' CYAN='' YELLOW='' BOLD='' ENDB=''
FILE=''
IMPLICIT_STDIN=''
WANT_HEADER=''
WANT_PAYLOAD=''
DEBUG=''
PARTS='.[0],.[1]' # .[0] is the header, .[1] the payload
RAW_TAIL='gsub("-";"+") | gsub("_";"/") | @base64d | fromjson'
RAW="split(\".\") | $PARTS | $RAW_TAIL"

version() {
  echo "mw-jwq v$VERSION"
}

usage() {
  cat <<EOF

${BOLD}$(version)${ENDB}

${BOLD}Usage:${ENDB} $(basename "${BASH_SOURCE[0]}") [-V] [-h] [-v] [-c] ( -f FILE | STRING | < FILE )
EOF
}

help() {
  cat <<EOF
$(usage)
Wrapper for: ( cat FILE / echo STRING / stdin ) | jq -R '${RAW}'

${BOLD}Available options:${ENDB}

-h,  --help           Print this help and exit
-V,  --version        Print version and exit
-f,  --file FILE      Read JWT from FILE ('-' for stdin)
-H,  --header         Print only the header of each JWT
-p,  --payload        Print only the payload of each JWT
    --color[=WHEN]    Color output: auto (default), always or never
-c,  --no-color       Same as --color=never
-v,  --verbose        Print script debug info (the JWT given as STRING and the jq command)
-vv, --hyper-verbose  More debug info (set -x)

EOF
}

cleanup() {
  trap - SIGINT SIGTERM ERR EXIT
  # script cleanup here
}

# Succeeds if output to file descriptor $1 should be colored. In auto mode
# that means a terminal, NO_COLOR unset and a TERM that supports it.
want_color() {
  case "$COLOR_MODE" in
  always) return 0 ;;
  never) return 1 ;;
  esac
  [[ -t "$1" ]] && [[ -z "${NO_COLOR-}" ]] && [[ "${TERM-}" != "dumb" ]]
}

# stderr messages use the colors; the usage and help, printed on stdout, only
# use BOLD. Both are decided here, once, because usage runs inside $(...).
setup_colors() {
  if want_color 2; then
    NOFORMAT=$'\033[0m' RED=$'\033[0;31m' GREEN=$'\033[0;32m' ORANGE=$'\033[0;33m' BLUE=$'\033[0;34m' PURPLE=$'\033[0;35m' CYAN=$'\033[0;36m' YELLOW=$'\033[1;33m'
  else
    NOFORMAT='' RED='' GREEN='' ORANGE='' BLUE='' PURPLE='' CYAN='' YELLOW=''
  fi
  if want_color 1; then
    BOLD=$'\033[1m' ENDB=$'\033[0m'
  else
    BOLD='' ENDB=''
  fi
}

set_color_mode() {
  COLOR_MODE=$1
  setup_colors
}

msg() {
  echo >&2 "${1-}"
}

die() {
  local msg=$1
  local code=${2-1} # default exit status 1
  msg "${RED}${msg}${NOFORMAT}"
  exit "$code"
}

parse_params() {
  [[ $# -eq 0 && -t 0 ]] && usage && exit 1

  while :; do
    case "${1-}" in
    -V  | --version) version ; exit 0 ;;
    -h  | --help) help ; exit 0 ;;
    -v  | --verbose) DEBUG=1 ;;               # flags
    -vv | --hyper-verbose) DEBUG=1; set -x ;; 
    -H  | --header) WANT_HEADER=1 ;;
    -p  | --payload) WANT_PAYLOAD=1 ;;
    -c  | --no-color) set_color_mode never ;;
    --color) set_color_mode always ;;
    --color=*)
      [[ "${1#--color=}" =~ ^(auto|always|never)$ ]] || die "Invalid value for --color: '${1#--color=}' (use auto, always or never)"
      set_color_mode "${1#--color=}"
      ;;
    -f  | --file)                             # named parameters
      FILE="${2-}"
      [[ -z "$FILE" ]] && die "Missing argument for option '$1'"
      [[ "$FILE" != - && ! -f "$FILE" ]] && die "File '$FILE' does not exist"
      shift
      ;;
    --) shift; break ;;
    -?*) die "Unknown option: $1" ;;
    *) break ;;
    esac
    shift
  done

  args=("$@")
  STRING=$(IFS= ; echo "${args[*]-}")

  local trimmed
  trimmed=$(tr -d '[:space:]' <<<"$STRING")

  [[ -n "$trimmed" ]] && [[ -n "$FILE" ]] && die "Use either -f FILE or STRING, not both"
  if [[ -z "$trimmed" ]] && [[ -z "$FILE" ]]; then
    # Nothing given: read from a pipe or redirect, but never wait on a terminal
    [[ -t 0 ]] && usage && die "Missing argument: STRING or FILE"
    FILE=- IMPLICIT_STDIN=1
  fi

  return 0
}

setup_colors
parse_params "$@"

# Script
if want_color 1; then
  OPTIONS="-C"
else
  OPTIONS="-M"
fi

# Read the input and split it into tokens. Whitespace is dropped. A token may
# span several lines, and a new one starts at a line where a JWT header begins
# once the current token has its 3 dot separated parts. A signature never has
# a dot, so a line with one also starts a new token.

# Succeeds if the lines from index $1 start with a header: the text up to the
# first dot decodes to a JSON object. This tells a new token apart from a
# signature wrapped onto a line that happens to start like a header.
header_starts_at() {
  local i=$1 text=${LINES_IN[$1]}
  while [[ "$text" != *.* ]] && ((++i < ${#LINES_IN[@]})); do
    text+=${LINES_IN[i]}
  done
  [[ "$text" == *.* ]] || return 1
  jq -Re 'try (gsub("-";"+") | gsub("_";"/") | @base64d | fromjson | type == "object") catch false' \
    <<<"${text%%.*}" >/dev/null 2>&1
}

if [ -n "$FILE" ]; then
  INPUT=$(cat -- "$FILE")
  if [[ -n "$IMPLICIT_STDIN" && -z "$(tr -d '[:space:]' <<<"$INPUT")" ]]; then
    usage
    die "Missing argument: STRING or FILE"
  fi
else
  STRING=$(IFS= ; echo "${args[*]-}")
  INPUT="$STRING"
  [[ -n "$DEBUG" ]] && msg "${CYAN}JWT: '$(tr -d '[:space:]' <<<"$STRING")'${NOFORMAT}"
fi

LINES_IN=()
while IFS= read -r line || [[ -n "$line" ]]; do
  line=$(tr -d '[:space:]' <<<"$line")
  [[ -n "$line" ]] && LINES_IN+=("$line")
done <<<"$INPUT"

TOKENS=()
BUFFER=''
for i in ${LINES_IN[@]+"${!LINES_IN[@]}"}; do
  line=${LINES_IN[i]}
  if [[ "$BUFFER" == *.*.* ]] && { [[ "$line" == *.* ]] || { [[ "$line" =~ ^e[wy] ]] && header_starts_at "$i"; }; }; then
    TOKENS+=("$BUFFER")
    BUFFER=''
  fi
  BUFFER+="$line"
done
[[ -n "$BUFFER" ]] && TOKENS+=("$BUFFER")

for token in ${TOKENS[@]+"${TOKENS[@]}"}; do
  [[ "$token" == *.*.*.* ]] && die "Invalid token (too many parts): '$token'" 5
done

# With just one of -H and -p only that part is printed; with both, or none, both.
if [[ -n "$WANT_HEADER" && -z "$WANT_PAYLOAD" ]]; then
  PARTS='.[0]'
elif [[ -z "$WANT_HEADER" && -n "$WANT_PAYLOAD" ]]; then
  PARTS='.[1]'
fi
RAW="split(\".\") | $PARTS | $RAW_TAIL"

CMD="jq -R '$RAW' $OPTIONS"

if [ -n "${DEBUG}" ]; then
  msg "${GREEN}>>  $CMD${NOFORMAT}"
fi

# jq exits with the status of its last input only, so run it once per token and
# keep the first failure.
STATUS=0
for token in ${TOKENS[@]+"${TOKENS[@]}"}; do
  rc=0
  printf '%s\n' "$token" | jq -R "$RAW" $OPTIONS || rc=$?
  if [[ $STATUS -eq 0 ]]; then STATUS=$rc; fi
done
exit "$STATUS"
